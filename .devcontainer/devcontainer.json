{
  "name": "HA Theme Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "homeassistant",
  "workspaceFolder": "/workspaces/very-dark-black-ha-theme",
  "_comment": "Added -U to ensure it upgrades if a cached version is old",
  "postCreateCommand": "sed -i 's/\\r$//' .devcontainer/setup.sh && sh .devcontainer/setup.sh || (echo 'Setup failed! Check .reports/devcontainer/post_setup.log for details.' && sleep infinity)",
  "mounts": [
    {
      "source": "${localEnv:USERPROFILE}/.gemini",
      "target": "/root/.gemini",
      "type": "bind"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "keesschollaart.vscode-home-assistant",
        "davidanson.vscode-markdownlint",
        "yzhang.markdown-all-in-one",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "yaml.schemas": {
          "https://raw.githubusercontent.com/hacs/default/master/hacs.json": "hacs.json",
          "https://raw.githubusercontent.com/home-assistant/schemas/main/frontend/lovelace_config.json": "ui-lovelace.yaml"
        },
        "yaml.validate": true,
        "editor.formatOnSave": true,
        "markdownlint.config": {
          "MD013": false,
          "MD033": false
        },
        "cSpell.enabled": true
      }
    }
  },
  "remoteUser": "root",
  "overrideCommand": false
}
