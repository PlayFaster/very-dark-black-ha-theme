{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "YAML: Lint Project",
      "type": "shell",
      "command": "mkdir -p .reports && git ls-files -z --cached --others --exclude-standard '*.yml' '*.yaml' | xargs -0 -r yamllint -c .validate/.yamllint | tee .reports/yaml_lint.txt",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "JSON: Verify All Files",
      "type": "shell",
      "command": "mkdir -p .reports && git ls-files -z --cached --others --exclude-standard '*.json' | xargs -0 -r check-jsonschema --schemafile https://json-schema.org/draft/2020-12/schema | tee .reports/json_validation.txt",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "HACS: Verify Manifest",
      "type": "shell",
      "command": "mkdir -p .reports && check-jsonschema --schemafile .validate/hacs_schema.json hacs.json | tee .reports/hacs_validation.txt",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "HA: Check Config",
      "type": "shell",
      "command": "mkdir -p .reports && hass --script check_config --config /config | tee .reports/ha_check_config.txt",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Markdown: Check Links",
      "type": "shell",
      "command": "mkdir -p .reports && markdown-link-check README.md | tee .reports/markdown_link_check.txt",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Markdown: Lint (View Only)",
      "type": "shell",
      "command": "mkdir -p .reports && git ls-files -z --cached --others --exclude-standard '*.md' | xargs -0 -r markdownlint --config .validate/.markdownlint.json | tee .reports/markdown_lint.txt",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Markdown: Lint (Auto-Fix)",
      "type": "shell",
      "command": "git ls-files -z --cached --others --exclude-standard '*.md' | xargs -0 -r markdownlint --config .validate/.markdownlint.json --fix || true",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Codespell: Check (View Only)",
      "type": "shell",
      "command": "mkdir -p .reports && codespell . --config .validate/.codespellrc | tee .reports/codespell.txt",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Codespell: Fix (Auto-Repair)",
      "type": "shell",
      "command": "codespell . --config .validate/.codespellrc -w || true",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Prettier: Check (View Only)",
      "type": "shell",
      "command": "mkdir -p .reports && git ls-files -z --cached --others --exclude-standard '*.md' '*.json' '*.yaml' '*.yml' | xargs -0 -r prettier --config .validate/.prettierrc.json --check | tee .reports/prettier_check.txt",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Prettier: Format (Auto-Fix)",
      "type": "shell",
      "command": "git ls-files -z --cached --others --exclude-standard '*.md' '*.json' '*.yaml' '*.yml' | xargs -0 -r prettier --config .validate/.prettierrc.json --write || true",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Prettier: Fix Notes",
      "type": "shell",
      "command": "prettier --config .validate/.prettierrc.json --ignore-path /dev/null --write \".notes/**/*.{md,json,yaml,yml}\" || true",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Prettier: Fix Shared",
      "type": "shell",
      "command": "prettier --config .validate/.prettierrc.json --ignore-path /dev/null --write \".shared/**/*.{md,json,yaml,yml}\" || true",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Zizmor: GitHub Actions Audit",
      "type": "shell",
      "command": "mkdir -p .reports && zizmor --pedantic .github/ | tee .reports/zizmor_audit.txt",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Zizmor: Fix (Safe Auto-Fix)",
      "type": "shell",
      "command": "zizmor --fix .github/ || true",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Env: Sync Shared Files",
      "type": "shell",
      "command": "mkdir -p .reports && sh .shared/validate-configs/sync_shared_files.sh | tee .reports/sync_shared_files.txt",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Env: Audit Version Drift",
      "type": "shell",
      "command": "mkdir -p .reports && python3 .shared/validate-configs/check_tool_drift.py | tee .reports/tool_drift_raw.txt && sed -e 's/.*\\r//g' -e 's/\\x1b\\[[0-9;]*[a-zA-Z]//g' .reports/tool_drift_raw.txt > .reports/tool_drift.txt && rm .reports/tool_drift_raw.txt",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "command": "python3 .shared/validate-configs/check_tool_drift.py --apply",
      "label": "Env: Apply Version Matrix Targets",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "python3 .shared/validate-configs/check_tool_drift.py --absorb",
      "label": "Env: Absorb Pre-commit Bumps",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "dependsOn": [
        "Env: Sync Shared Files",
        "Env: Audit Version Drift"
      ],
      "dependsOrder": "sequence",
      "label": "Env: [Workflow] Sync & Audit",
      "presentation": {
        "clear": true,
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "dependsOn": [
        "Env: Apply Version Matrix Targets",
        "Env: Sync Shared Files",
        "Env: Audit Version Drift"
      ],
      "dependsOrder": "sequence",
      "label": "Env: [Workflow] Apply & Propagate Changes",
      "presentation": {
        "clear": true,
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "dependsOn": [
        "Env: Absorb Pre-commit Bumps",
        "Env: Sync Shared Files",
        "Env: Audit Version Drift"
      ],
      "dependsOrder": "sequence",
      "label": "Env: [Workflow] Absorb & Propagate Bumps",
      "presentation": {
        "clear": true,
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Initialize Reports",
      "type": "shell",
      "command": "mkdir -p .reports",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Validate All",
      "dependsOn": [
        "Initialize Reports",
        "YAML: Lint Project",
        "JSON: Verify All Files",
        "HACS: Verify Manifest",
        "HA: Check Config",
        "Markdown: Check Links",
        "Markdown: Lint (View Only)",
        "Codespell: Check (View Only)",
        "Zizmor: GitHub Actions Audit",
        "Prettier: Check (View Only)"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Fix All",
      "dependsOn": [
        "Markdown: Lint (Auto-Fix)",
        "Codespell: Fix (Auto-Repair)",
        "Prettier: Format (Auto-Fix)",
        "Prettier: Fix Notes",
        "Prettier: Fix Shared"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "close": false
      }
    }
  ]
}
